# ===== FreeRADIUS database credentials =====
FUP_DB_HOST=localhost
FUP_DB_PORT=3306
FUP_DB_NAME=raddb
FUP_DB_USER=raduser
FUP_DB_PASSWORD=

# ===== MikroTik CoA router =====
FUP_NAS_IP=10.6.7.1
FUP_NAS_COA_PORT=3799
FUP_NAS_SECRET=

# ===== Paths =====
FUP_LOG_FILE=/var/log/fup.log
FUP_LOCK_FILE=/tmp/fup.lock
FUP_RADCLIENT=/usr/bin/radclient
FUP_RADCLIENT_DICT=/usr/share/freeradius
FUP_RADCLIENT_DICT_DIR=/etc/freeradius/3.0

# ===== Debug =====
# 0 = log file only (default)
# 1 = also echo every log line to console (stderr), incl. COA_DEBUG argv/body
# 2 = 1 + per-session/per-IP detail and raw CoA values
# Malformed or out-of-range values are treated as 0.
FUP_DEBUG=0
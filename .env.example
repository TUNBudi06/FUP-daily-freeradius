# ===== FreeRADIUS database credentials =====
FUP_DB_HOST=localhost
FUP_DB_PORT=3306
FUP_DB_NAME=raddb
FUP_DB_USER=raduser
FUP_DB_PASSWORD=

# ===== MikroTik CoA router =====
FUP_NAS_IP=10.6.7.1
FUP_NAS_COA_PORT=3799
FUP_NAS_SECRET=

# ===== Paths =====
FUP_LOG_FILE=/var/log/fup.log
FUP_LOCK_FILE=/tmp/fup.lock
FUP_RADCLIENT=/usr/bin/radclient
FUP_RADCLIENT_DICT=/usr/share/freeradius
FUP_RADCLIENT_DICT_DIR=/etc/freeradius/3.0

# ===== Debug =====
# Set FUP_DEBUG=1 to echo every log line to console (stderr)
FUP_DEBUG=1